{
  "name": "jobradar",
  "version": "1.2.0-beta",
  "description": "Deterministic job application tracker, interview stage monitor and follow-up reminder engine: local-first, privacy-respecting, zero-dependency.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/JobRadar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/JobRadar.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/JobRadar/issues"
  },
  "keywords": [
    "jobradar",
    "job-tracker",
    "job-hunt",
    "application-tracker",
    "career-tool",
    "job-applications",
    "interview-tracker",
    "follow-up-reminder",
    "local-first",
    "privacy-first",
    "cv-versioning",
    "ical",
    "cli",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "jobradar": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "README.it.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node --import tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
